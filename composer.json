{
  "name": "tearoom1/uniform-contact-block",
  "description": "Kirby plugin for a uniform based contact form block",
  "license": "MIT",
  "type": "kirby-plugin",
  "homepage": "https://github.com/tearoom1/uniform-contact-block",
  "version": "3.4.1",
  "keywords": [
    "kirby",
    "form",
    "block"
  ],
  "authors": [
    {
      "name": "Mathis Koblin",
      "email": "mail@tearoom.one",
      "homepage": "https://www.tearoom.one",
      "role": "Maintainer"
    }
  ],
  "support": {
    "docs": "https://github.com/tearoom1/uniform-contact-block/blob/main/README.md",
    "source": "https://github.com/tearoom1/uniform-contact-block"
  },
  "require": {
    "php": ">=8.1",
    "getkirby/composer-installer": "^1.1",
    "mzur/kirby-uniform": "^5.6",
    "refbw/uniform-simple-captcha": "^2.1",
    "tearoom1/uniform-spam-words": "^1.0"
  },
  "conflict": {
    "getkirby/cms": "<4.0"
  },
  "autoload": {
    "psr-4": {
      "TearoomOne\\UniformContactBlock\\": "src/"
    }
  },
  "require-dev": {
    "getkirby/cms": "^4.0 || ^5.0",
    "phpunit/phpunit": "^11.0"
  },
  "autoload-dev": {
    "psr-4": {
      "TearoomOne\\UniformContactBlock\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "optimize-autoloader": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "funding": [
    {
      "type": "custom",
      "url": "https://www.tearoom.one/en/kirby-plugins/support"
    },
    {
      "type": "Buy me a coffee",
      "url": "https://buymeacoffee.com/tearoom1"
    },
    {
      "type": "Github Sponsors",
      "url": "https://github.com/sponsors/tearoom1"
    }
  ]
}
